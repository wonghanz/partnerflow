# PartnerFlow LLM provider — DeepSeek (OpenAI-compatible)
#
# Paste your own key into PARTNERFLOW_LLM_API_KEY below. The system reads it at
# runtime, never writes it back, never logs it, and never returns it from
# /api/health (status() only reports whether a provider is configured).
#
# Leave the key empty and the app still runs: answers degrade to
# corpus-grounded extractive RAG plus the deterministic rule engine.

PARTNERFLOW_LLM_BASE_URL=https://api.deepseek.com/v1
PARTNERFLOW_LLM_MODEL=deepseek-v4.1-flash
PARTNERFLOW_LLM_API_KEY=
