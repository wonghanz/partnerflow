[
  {
    "rule_id": "R-DOC-005",
    "code": "REQ-DOC-001",
    "name": "Required Supporting Documents for Claims",
    "description": "Defines mandatory supporting evidence for claim reimbursement: at least one verified tax invoice, watermarked event photos, signed attendee roster, and payment advice slip.",
    "category": "DOCUMENT",
    "status": "active",
    "applies_to": { "submission_types": ["CLAIM"], "programmes": ["All Programmes"], "tiers": ["All Tiers"] },
    "condition": { "type": "DOCUMENTS_PRESENT", "expression": "all(required_documents) in submitted_document_types", "params": { "required": ["TAX_INVOICE", "EVENT_PHOTOS", "ATTENDEE_SIGNIN", "PROOF_OF_PAYMENT"] } },
    "on_fail": "REQUEST_MISSING_DOCUMENTS",
    "severity": "WARNING",
    "error_code": "MISSING_SUPPORTING_DOCUMENTS",
    "policy_ref": "policies/claim-eligibility.md#sec-2",
    "approved_by": "Chief Financial Officer (CFO)",
    "version": "v2026.3.0",
    "effective_date": "2026-03-01",
    "provenance": "documented"
  },
  {
    "rule_id": "R-DOC-PA-014",
    "code": "REQ-DOC-002",
    "name": "Pre-Approval Required Documentation",
    "description": "Pre-approval applications must include the official application form with itemized budget lines, vendor quotations, and event agenda before commitments can be reserved.",
    "category": "DOCUMENT",
    "status": "active",
    "applies_to": { "submission_types": ["PRE_APPROVAL"], "programmes": ["All Programmes"], "tiers": ["All Tiers"] },
    "condition": { "type": "DOCUMENTS_PRESENT", "expression": "all(required_documents) in submitted_document_types", "params": { "required": ["PRE_APPROVAL_FORM", "QUOTATION", "AGENDA"] } },
    "on_fail": "REQUEST_MISSING_DOCUMENTS",
    "severity": "WARNING",
    "error_code": "MISSING_SUPPORTING_DOCUMENTS",
    "policy_ref": "policies/pre-approval.md#sec-1.1",
    "approved_by": "VP Global Channel Operations & Finance",
    "version": "v2026.3.0",
    "effective_date": "2026-03-01",
    "provenance": "documented"
  },
  {
    "rule_id": "R-PARTNER-006",
    "code": "REQ-ELIG-001",
    "name": "Partner Active Status & Eligibility",
    "description": "Validates partner master registry to verify partner_id exists and maintains an active contractual status. Suspended or inactive partners are blocked from fund disbursement.",
    "category": "ELIGIBILITY",
    "status": "active",
    "applies_to": { "submission_types": ["PRE_APPROVAL", "CLAIM"], "programmes": ["All Programmes"], "tiers": ["All Tiers"] },
    "condition": { "type": "PARTNER_STATUS_EQUALS", "expression": "partner.status == 'active'", "params": { "required_status": "active" } },
    "on_fail": "BLOCK_PROGRESSION",
    "severity": "BLOCKER",
    "error_code": "PARTNER_NOT_ACTIVE",
    "policy_ref": "policies/tier-benefits.md#table-1",
    "approved_by": "Director of Channel Governance",
    "version": "v2026.3.0",
    "effective_date": "2026-03-01",
    "provenance": "documented"
  },
  {
    "rule_id": "R-LINK-007",
    "code": "REQ-LINK-001",
    "name": "Pre-Approval Mandatory Linkage",
    "description": "Claims must bind a valid parent_pre_approval_id that is in APPROVED state. Claims without prior approval or with rejected approvals are halted for policy review.",
    "category": "ELIGIBILITY",
    "status": "active",
    "applies_to": { "submission_types": ["CLAIM"], "programmes": ["All Programmes"], "tiers": ["All Tiers"] },
    "condition": { "type": "PRE_APPROVAL_LINKED_AND_APPROVED", "expression": "parent_pre_approval.state == 'APPROVED'", "params": {} },
    "on_fail": "BLOCK_PROGRESSION",
    "severity": "BLOCKER",
    "error_code": "PRE_APPROVAL_NOT_READY",
    "policy_ref": "policies/pre-approval.md#sec-2.4",
    "approved_by": "Chief Financial Officer (CFO)",
    "version": "v2026.3.0",
    "effective_date": "2026-03-01",
    "provenance": "documented"
  },
  {
    "rule_id": "R-BUD-002",
    "code": "REQ-BUD-001",
    "name": "Quarterly Budget Cap Sufficiency",
    "description": "Ensures requested amount does not exceed partner's available four-state allocation (Available = Allocated - (Committed + Approved + Paid) >= 0). Over-budget claims are automatically blocked.",
    "category": "FINANCE",
    "status": "active",
    "applies_to": { "submission_types": ["PRE_APPROVAL", "CLAIM"], "programmes": ["All Programmes"], "tiers": ["All Tiers"] },
    "condition": { "type": "BUDGET_AVAILABLE", "expression": "amount <= partner.available_budget", "params": {} },
    "on_fail": "BLOCK_PROGRESSION",
    "severity": "BLOCKER",
    "error_code": "BUDGET_CAP_EXCEEDED",
    "policy_ref": "policies/budget-management.md#sec-3",
    "approved_by": "Chief Financial Officer (CFO)",
    "version": "v2026.3.0",
    "effective_date": "2026-03-01",
    "provenance": "documented"
  },
  {
    "rule_id": "R-EXP-004",
    "code": "REQ-EXP-001",
    "name": "Ineligible Expense Exclusions",
    "description": "Prohibits reimbursement for entertainment, alcoholic beverages, personal dining, or non-marketing gifts. Line items matching prohibited keywords must be deducted.",
    "category": "FINANCE",
    "status": "active",
    "applies_to": { "submission_types": ["CLAIM"], "programmes": ["All Programmes"], "tiers": ["All Tiers"] },
    "condition": { "type": "NO_INELIGIBLE_EXPENSES", "expression": "ineligible_items.count == 0", "params": { "banned_tokens": ["alcohol", "wine", "beer", "entertainment", "karaoke", "gift card"] } },
    "on_fail": "BLOCK_PROGRESSION",
    "severity": "BLOCKER",
    "error_code": "INELIGIBLE_EXPENSE_DETECTED",
    "policy_ref": "policies/claim-eligibility.md#sec-3.2",
    "approved_by": "VP Global Channel Operations & Finance",
    "version": "v2026.3.0",
    "effective_date": "2026-03-01",
    "provenance": "documented"
  },
  {
    "rule_id": "R-DIG-009",
    "code": "REQ-DIG-001",
    "name": "Digital Marketing Analytics Verification",
    "description": "Digital marketing reimbursements require third-party ad network analytics exports showing impressions, clicks, date range, and approved brand lockups.",
    "category": "DOCUMENT",
    "status": "active",
    "applies_to": { "submission_types": ["CLAIM"], "programmes": ["Retail Merchandising & POS Rebate"], "tiers": ["All Tiers"] },
    "condition": { "type": "DIGITAL_ANALYTICS_PRESENT", "expression": "digital_analytics_verified == true", "params": {} },
    "on_fail": "REQUEST_CLARIFICATION",
    "severity": "WARNING",
    "error_code": "MISSING_ANALYTICS_TELEMETRY",
    "policy_ref": "policies/digital-guidelines.md#sec-1.4",
    "approved_by": "Lead Compliance Auditor",
    "version": "v2026.3.0",
    "effective_date": "2026-03-01",
    "provenance": "documented"
  },
  {
    "rule_id": "R-SEC-001",
    "code": "REQ-SEC-001",
    "name": "Document Tamper & Fraud Quarantine",
    "description": "Gatekeeper & Fraud Sentinel enforce SHA-256 collision detection and metadata timestamp verification. Tampered or duplicate invoices trigger immediate quarantine.",
    "category": "SECURITY",
    "status": "active",
    "applies_to": { "submission_types": ["PRE_APPROVAL", "CLAIM"], "programmes": ["All Programmes"], "tiers": ["All Tiers"] },
    "condition": { "type": "INTEGRITY_CHECK", "expression": "hash_duplicate == false && metadata_tamper == false", "params": {} },
    "on_fail": "QUARANTINE_SUBMISSION",
    "severity": "BLOCKER",
    "error_code": "SECURITY_HASH_AND_TAMPER_DETECTED",
    "policy_ref": "policies/security-audit.md#sec-4.1",
    "approved_by": "Chief Information Security Officer (CISO)",
    "version": "v2026.3.0",
    "effective_date": "2026-03-01",
    "provenance": "documented"
  }
]
